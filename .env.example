# ─── AI (required for /api/ask) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Required for live psychology-coach calls via the Realtime API.
OPENAI_API_KEY=
# Optional overrides (defaults in src/lib/ask/service/provider.ts)
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_FALLBACK_MODEL=claude-sonnet-4-6
# The Ask pipeline retrieves knowledge then answers in one Sonnet pass
# (needs migration_17 + seed:knowledge for the RAG layer).

# ─── Branding (browser-safe; optional — defaults match local product name) ───
NEXT_PUBLIC_APP_NAME=verify.trading
# Canonical site origin for metadata, canonicals, robots, sitemap & JSON-LD (defaults to https://www.verify.trading).
# NEXT_PUBLIC_SITE_URL=https://www.verify.trading
# NEXT_PUBLIC_SITE_TITLE=verify.trading — Ask for traders
# NEXT_PUBLIC_SITE_DESCRIPTION=Your short SEO description.
# NEXT_PUBLIC_ONBOARDING_CALL_URL=https://calendly.com/verifytrading/-
# Optional: Markets CTA — defaults to NEXT_PUBLIC_ONBOARDING_CALL_URL when unset.
# NEXT_PUBLIC_TRADER_SUPPORT_CALL_URL=https://calendly.com/verifytrading/-
# NEXT_PUBLIC_TELEGRAM_COMMUNITY_URL=https://www.t.me/verifytradingai
# RapidAPI account key — economic calendar (forex-api2.p.rapidapi.com).
# RAPIDAPI_KEY=
# Shared secret required by Supabase Cron when invoking /api/cron/markets.
# Set the same value in Supabase Vault as `markets_cron_secret`.
# CRON_SECRET=
# Markets paywall: omit or `true` = overlay on for non-Pro (locked). Set `false` only to preview /markets without the overlay.
# NEXT_PUBLIC_MARKETS_PAYWALL_UI_ENABLED=false

# ─── Supabase (Auth, sessions, messages, image storage) ───────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare Turnstile site key. When set, the CAPTCHA gates signup, login, and
# forgot-password. The token is only *enforced* once the matching secret key is set in
# Supabase Auth > Bot and Abuse Protection — without it the widget is decorative, so
# either configure the secret or leave this unset rather than gating users for nothing.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ─── Stripe billing (server-only unless NEXT_PUBLIC_*) ─────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO_WEEKLY=price_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_MONTHLY_STANDARD=price_... # legacy fallback for monthly
# STRIPE_PRICE_PRO_ANNUAL=price_...
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_...

# ─── Transactional email (Resend) ──────────────────────────────────────────────
# RESEND_API_KEY=re_...
# EMAIL_FROM_SIGNUP=verify.trading <ai@verify.trading>
# EMAIL_FROM_SUBSCRIPTION=verify.trading <pro@verify.trading>

# ─── Market data (FMP) ───────────────────────────────────────────────────────
FMP_API_KEY=

# ─── News headlines (NewsAPI.org — optional; free tier is delayed + rate-limited) ─
# NEWS_API_KEY=

# ─── FCA lookups (optional) ──────────────────────────────────────────────────
# FCA_API_KEY=
# FCA_API_EMAIL=
# FCA_FIRM_LOOKUP_URL=

# ─── Ask response cache (optional) ───────────────────────────────────────────
# Kill switch for the shared single-entity answer cache. Set to "off" to make
# every Ask request run the full pipeline again (no redeploy of logic needed).
# ASK_RESPONSE_CACHE=off

# ─── Scripts / evals (optional) ──────────────────────────────────────────────
# ASK_EVAL_BASE_URL=http://localhost:3000
